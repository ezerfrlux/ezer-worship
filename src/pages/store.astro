---
import StoreSection from "../components/StoreSection.astro";
import Layout from "../layouts/Layout.astro";

const stats = [
	{ value: "09", label: "Packs" },
	{ value: "4K", label: "Motion ready" },
	{ value: "24/7", label: "Instant access" },
];
---

<Layout
	title="Store — EZER-WORSHIP"
	description="Motion loops, multitracks, and visual presets for worship services. Built to sit quietly behind the moment."
>
	<main id="main-content" class="site-main">
		<section class="store-intro" aria-labelledby="store-page-title">
			<div class="intro-inner">
				<p class="eyebrow">
					<span class="eyebrow-dot" aria-hidden="true"></span>
					Store / 2026
				</p>

				<div class="intro-copy">
					<h1 id="store-page-title" class="intro-title">Sound for the room.</h1>
					<p class="intro-lead">
						A small, deliberate catalog of worship media. Loops, multitracks, and presets
						that stay out of the way — so the room can do what it came to do.
					</p>
				</div>

				<dl class="stats">
					{stats.map((stat) => (
						<div class="stat">
							<dt class="stat-label">{stat.label}</dt>
							<dd class="stat-value">{stat.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<StoreSection
			eyebrow="Catalog / All packs"
			title="Every pack, one place."
			description="Filtered by nothing — the full set, from free backgrounds to full multitrack arrangements."
			showCta={false}
		/>
	</main>
</Layout>

<style>
	.store-intro {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 42%, transparent);
	}

	.store-intro::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(50% 90% at 72% 0%, rgb(255 255 255 / 6%), transparent 70%),
			linear-gradient(to right, rgb(255 255 255 / 3%) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(255 255 255 / 3%) 1px, transparent 1px);
		background-size: auto, 72px 72px, 72px 72px;
		-webkit-mask-image: radial-gradient(ellipse 85% 90% at 60% 30%, #000 5%, transparent 82%);
		mask-image: radial-gradient(ellipse 85% 90% at 60% 30%, #000 5%, transparent 82%);
	}

	.intro-inner {
		position: relative;
		width: 100%;
		max-width: var(--maxw);
		margin-inline: auto;
		padding: clamp(3.5rem, 8vw, 6.5rem) var(--gutter) clamp(2.5rem, 5vw, 4rem);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.eyebrow-dot {
		width: 0.3125rem;
		height: 0.3125rem;
		border-radius: 50%;
		background-color: var(--accent);
		flex: none;
	}

	.intro-copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.intro-title {
		max-width: 16ch;
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 7vw, 5rem);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.045em;
		color: var(--ink);
		text-wrap: balance;
	}

	.intro-lead {
		max-width: 46ch;
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
		text-wrap: pretty;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 2.5rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 45%, transparent);
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.25rem;
	}

	.stat-label {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.stat-value {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	@media (min-width: 768px) {
		.intro-copy {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			gap: 3rem;
		}

		.intro-lead {
			flex: none;
			width: min(32ch, 38%);
			padding-bottom: 0.35rem;
			text-align: right;
		}

		.stats {
			max-width: 32rem;
		}
	}

	@media (min-width: 1024px) {
		.intro-lead {
			font-size: 1rem;
		}
	}
</style>
