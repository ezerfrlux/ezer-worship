---
import ProductArt from "../../components/ProductArt.astro";
import Layout from "../../layouts/Layout.astro";
import {
	categoryLabels,
	products,
	type Product,
} from "../../data/products";

interface Props {
	product: Product;
}

export function getStaticPaths() {
	return products.map((product) => ({
		params: { id: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;
const isFree = product.price === "FREE";
const figure = String(products.findIndex((entry) => entry.id === product.id) + 1).padStart(2, "0");
const license = product.specs.find((spec) => spec.label === "License")?.value ?? "";
---

<Layout title={`${product.title} — EZER-WORSHIP`} description={product.description}>
	<main id="main-content" class="site-main">
		<div class="product-page">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a class="back-link" href="/store">
					<span class="back-arrow" aria-hidden="true">←</span>
					Back to store
				</a>
			</nav>

			<article class="product" aria-labelledby="product-title">
				<div class="product-grid">
					<figure class="media-column">
						<div class="product-media">
							<ProductArt product={product} />
							<span class="media-index" aria-hidden="true">{figure}</span>
							<span class="media-tag">{categoryLabels[product.category]}</span>
						</div>
						<figcaption class="media-caption">
							<span>Figure {figure}</span>
							<span>{product.resources}</span>
						</figcaption>
					</figure>

					<div class="purchase">
						<p class="eyebrow">
							<span class="eyebrow-dot" aria-hidden="true"></span>
							{categoryLabels[product.category]}
						</p>

						<h1 id="product-title" class="product-title">{product.title}</h1>

						<p class="product-description">{product.description}</p>

						<div class="buy-panel">
							<div class="price-row">
								<span class="price">{product.price}</span>
								<span class="price-note">
									{isFree ? "Free download" : "One-time payment"}
								</span>
							</div>

							<button
								class="buy-button"
								type="button"
								data-add-to-cart
								data-product-id={product.id}
								data-product-title={product.title}
								data-product-price={product.price}
								data-product-category={categoryLabels[product.category]}
								data-product-resources={product.resources}
								data-art-glow={product.art.glow}
								data-art-mid={product.art.mid}
								data-art-base={product.art.base}
								aria-pressed="false"
							>
								<span data-cart-label>Add to cart</span>
								<span class="buy-icon" data-cart-icon aria-hidden="true">+</span>
							</button>

							<p class="cart-status" role="status" aria-live="polite" data-cart-status></p>

							<div class="assurances">
								<span>Instant download</span>
								<span>{license}</span>
							</div>
						</div>

						<dl class="meta">
							<div class="meta-row">
								<dt>Released</dt>
								<dd>{product.timeAgo}</dd>
							</div>
							<div class="meta-row">
								<dt>Includes</dt>
								<dd>{product.resources}</dd>
							</div>
							<div class="meta-row">
								<dt>Collection</dt>
								<dd>{categoryLabels[product.category]}</dd>
							</div>
						</dl>
					</div>
				</div>
			</article>

			<section class="details" aria-labelledby="details-title">
				<div class="details-grid">
					<div class="contents">
						<h2 id="details-title" class="details-title">What's inside</h2>
						<ul class="contents-list">
							{product.contents.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>

					<div class="specs">
						<h2 class="details-title">Download & specs</h2>
						<dl class="spec-list">
							{product.specs.map((spec) => (
								<div class="spec-row">
									<dt>{spec.label}</dt>
									<dd>{spec.value}</dd>
								</div>
							))}
						</dl>
						<p class="spec-note">
							Files are delivered immediately after checkout. A download link stays
							available for 30 days.
						</p>
					</div>
				</div>
			</section>
		</div>
	</main>
</Layout>

<script>
	import { addToCart, isInCart, removeFromCart } from "../../lib/cart";

	const button = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");

	if (button) {
		const id = button.dataset.productId ?? "";
		const title = button.dataset.productTitle ?? "";
		const price = button.dataset.productPrice ?? "";
		const category = button.dataset.productCategory;
		const resources = button.dataset.productResources;
		const art = button.dataset.artGlow && button.dataset.artMid && button.dataset.artBase
			? {
					glow: button.dataset.artGlow,
					mid: button.dataset.artMid,
					base: button.dataset.artBase,
				}
			: undefined;

		const label = button.querySelector<HTMLElement>("[data-cart-label]");
		const icon = button.querySelector<HTMLElement>("[data-cart-icon]");
		const status = document.querySelector<HTMLElement>("[data-cart-status]");

		const render = () => {
			const inCart = isInCart(id);
			button.setAttribute("aria-pressed", String(inCart));
			if (label) label.textContent = inCart ? "Remove from cart" : "Add to cart";
			if (icon) icon.textContent = inCart ? "−" : "+";
		};

		button.addEventListener("click", () => {
			if (isInCart(id)) {
				removeFromCart(id);
				if (status) status.textContent = `${title} removed from cart.`;
			} else {
				addToCart({ id, title, price, category, resources, art });
				if (status) status.textContent = `${title} added to cart.`;
			}

			render();
		});

		render();
	}
</script>

<style>
	.product-page {
		width: 100%;
		max-width: var(--maxw);
		margin-inline: auto;
		padding: 0 var(--gutter) clamp(4rem, 8vw, 7rem);
	}

	.breadcrumb {
		padding-block: 1.5rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-muted);
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: var(--ink);
	}

	.back-arrow {
		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1;
		transition: transform 160ms ease;
	}

	.back-link:hover .back-arrow {
		transform: translateX(-3px);
	}

	.product-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
	}

	.media-column {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
	}

	.product-media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		isolation: isolate;
		border: 1px solid color-mix(in srgb, var(--border-strong) 72%, transparent);
		border-radius: 0.25rem;
		background-color: var(--canvas-raised);
	}

	.media-index {
		position: absolute;
		top: 1.125rem;
		left: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.18em;
		color: rgb(255 255 255 / 62%);
	}

	.media-tag {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		display: inline-flex;
		align-items: center;
		height: 1.75rem;
		padding-inline: 0.625rem;
		border: 1px solid rgb(255 255 255 / 26%);
		border-radius: 999px;
		background-color: rgb(10 10 10 / 52%);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		line-height: 1;
		color: var(--ink);
	}

	.media-caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.purchase {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 34rem;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.eyebrow-dot {
		width: 0.3125rem;
		height: 0.3125rem;
		border-radius: 50%;
		background-color: var(--accent);
		flex: none;
	}

	.product-title {
		margin-top: 0.875rem;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5.4vw, 4rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--ink);
		text-wrap: balance;
	}

	.product-description {
		max-width: 46ch;
		margin-top: 1rem;
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
		text-wrap: pretty;
	}

	.buy-panel {
		width: 100%;
		margin-top: 1.75rem;
		padding: 1.25rem;
		background-color: var(--canvas-raised);
		border: 1px solid color-mix(in srgb, var(--border-strong) 72%, transparent);
		border-radius: 0.25rem;
	}

	.price-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.price {
		font-family: var(--font-mono);
		font-size: 2.25rem;
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.price-note {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.buy-button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		min-height: 3.5rem;
		margin-top: 1.25rem;
		padding-inline: 1.125rem;
		border: 1px solid var(--accent);
		border-radius: 0.25rem;
		background-color: var(--accent);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--accent-ink);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 120ms ease;
	}

	.buy-button:hover {
		background-color: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.buy-button:active {
		transform: scale(0.99);
	}

	.buy-button[aria-pressed="true"] {
		background-color: transparent;
		border-color: color-mix(in srgb, var(--border-strong) 55%, var(--ink) 45%);
		color: var(--ink);
	}

	.buy-icon {
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1;
	}

	.cart-status {
		min-height: 1rem;
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		color: var(--ink-muted);
	}

	.assurances {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.375rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.meta {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 1.5rem 0 0;
	}

	.meta-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.6875rem;
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 42%, transparent);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.04em;
	}

	.meta-row:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 42%, transparent);
	}

	.meta-row dt {
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--ink-muted);
	}

	.meta-row dd {
		margin: 0;
		text-align: right;
		color: var(--ink);
	}

	.details {
		margin-top: clamp(3.5rem, 7vw, 6rem);
		padding-top: clamp(2rem, 4vw, 3rem);
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 42%, transparent);
	}

	.details-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.details-title {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.contents-list {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.contents-list li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 0.8125rem;
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 38%, transparent);
		font-size: 0.9375rem;
		color: var(--ink);
	}

	.contents-list li:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 38%, transparent);
	}

	.contents-list li::before {
		content: "";
		flex: none;
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 50%;
		background-color: var(--accent);
	}

	.spec-list {
		margin: 1.25rem 0 0;
	}

	.spec-row {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 0.8125rem;
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 38%, transparent);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.04em;
	}

	.spec-row:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 38%, transparent);
	}

	.spec-row dt {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--ink-muted);
	}

	.spec-row dd {
		margin: 0;
		color: var(--ink);
	}

	.spec-note {
		max-width: 44ch;
		margin-top: 1rem;
		font-size: 0.8125rem;
		line-height: 1.7;
		color: var(--ink-muted);
	}

	@media (min-width: 640px) {
		.product-description {
			font-size: 1rem;
		}
	}

	@media (min-width: 900px) {
		.breadcrumb {
			padding-block: 2rem;
		}

		.product-grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			align-items: start;
		}

		.media-column {
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
		}

		.details-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: clamp(3rem, 7vw, 6rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link:hover .back-arrow {
			transform: none;
		}

		.buy-button:active {
			transform: none;
		}
	}
</style>
