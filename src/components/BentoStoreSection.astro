---
// src/components/BentoStoreSection.astro
import {
    categoryLabels,
    products,
    type ProductCategory,
} from "../data/products";
import ProductArt from "./ProductArt.astro";

interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    showCta?: boolean;
    ctaHref?: string;
    ctaLabel?: string;
}

const {
    eyebrow = "Store / Modular architecture",
    title = "Engineered for the room.",
    description = "Motion loops, ambient multitracks, and precision presets structured in a modular bento layout.",
    showCta = true,
    ctaHref = "/store",
    ctaLabel = "Explore full catalog",
} = Astro.props;

const bentoItems = products.slice(0, 4);
---

<section class="bento-section" aria-labelledby="bento-title">
    <div class="bento-inner">
        <header class="section-head">
            <div class="head-copy">
                <p class="eyebrow">
                    <span class="eyebrow-dot" aria-hidden="true"></span>
                    {eyebrow}
                </p>
                <h2 id="bento-title" class="section-title">{title}</h2>
                <p class="section-lead">{description}</p>
            </div>

            {showCta && (
                <a class="section-link" href={ctaHref}>
                    {ctaLabel}
                    <span class="link-arrow" aria-hidden="true">→</span>
                </a>
            )}
        </header>

        {bentoItems.length > 0 ? (
            <div class="bento-grid">
                {bentoItems.map((product, index) => {
                    return (
                        <article class={`bento-item bento-item--${index + 1}`}>
                            <a
                                class="card"
                                id={product.id}
                                href={`/store/${product.id}`}
                                aria-label={`${product.title}, ${product.price}. ${categoryLabels[product.category]}, ${product.resources}. View pack.`}
                            >
                                <div class="card-media">
                                    <ProductArt product={product} />

                                    <span class="card-index" aria-hidden="true">
                                        {String(index + 1).padStart(2, "0")}
                                    </span>

                                    <span class:list={["price", product.price === "FREE" && "price--free"]}>
                                        {product.price}
                                    </span>
                                </div>

                                <div class="card-content">
                                    <div class="card-topline">
                                        <p class="card-category">{categoryLabels[product.category]}</p>
                                        {product.featured && (
                                            <span class="card-flag">
                                                <span class="flag-dot" aria-hidden="true"></span>
                                                New
                                            </span>
                                        )}
                                    </div>

                                    <h3 class="card-title">{product.title}</h3>

                                    <div class="card-meta">
                                        <span>{product.timeAgo}</span>
                                        <span>{product.resources}</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    );
                })}
            </div>
        ) : (
            <p class="empty">No packs available in the bento grid yet.</p>
        )}
    </div>
</section>

<style>
    .bento-section {
        position: relative;
        width: 100%;
        background-color: var(--canvas);
        border-top: 1px solid color-mix(in srgb, var(--border-strong) 42%, transparent);
    }

    .bento-section::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 24rem;
        pointer-events: none;
        background: radial-gradient(55% 100% at 50% 0%, rgb(255 255 255 / 4%), transparent 72%);
    }

    .bento-inner {
        position: relative;
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding: clamp(3.5rem, 8vw, 7rem) var(--gutter);
    }

    .section-head {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: clamp(2rem, 4vw, 3rem);
    }

    .head-copy {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink-muted);
    }

    .eyebrow-dot {
        width: 0.3125rem;
        height: 0.3125rem;
        border-radius: 50%;
        background-color: var(--accent);
        flex: none;
    }

    .section-title {
        max-width: 18ch;
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.4vw, 3.25rem);
        font-weight: 500;
        line-height: 1.04;
        letter-spacing: -0.04em;
        color: var(--ink);
        text-wrap: balance;
    }

    .section-lead {
        max-width: 42ch;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--ink-muted);
        text-wrap: pretty;
    }

    .section-link {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.5rem;
        min-height: 2.75rem;
        padding: 0 1.125rem;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        transition:
            background-color 180ms ease,
            border-color 180ms ease;
    }

    .section-link:hover {
        background-color: var(--hover);
        border-color: color-mix(in srgb, var(--border-strong) 65%, var(--ink) 35%);
    }

    .link-arrow {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        line-height: 1;
        transition: transform 180ms ease;
    }

    .section-link:hover .link-arrow {
        transform: translateX(3px);
    }

    /* --- BENTO GRID SYSTEM --- */
    .bento-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        margin: 0;
        padding: 0;
    }

    .bento-item {
        display: flex;
        min-width: 0;
    }

    .card {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: var(--canvas-raised);
        border: 1px solid color-mix(in srgb, var(--border-strong) 72%, transparent);
        border-radius: 0.25rem;
        scroll-margin-top: calc(var(--header-h) + 1.5rem);
        transition:
            border-color 260ms ease,
            box-shadow 260ms ease,
            transform 260ms ease;
    }

    .card:hover {
        border-color: color-mix(in srgb, var(--border-strong) 45%, var(--ink) 55%);
        box-shadow:
            0 0 0 1px rgb(255 255 255 / 6%),
            0 0 44px -16px rgb(255 255 255 / 22%),
            0 32px 60px -42px rgb(0 0 0 / 90%);
        transform: translateY(-2px);
    }

    .card:focus-visible {
        outline-offset: 3px;
    }

    .card-media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        isolation: isolate;
        background-color: var(--canvas-raised);
    }

    /* Celda principal (Flagship): contenedor de medios más vertical e imponente */
    .bento-item--1 .card-media {
        aspect-ratio: 4 / 5;
    }

    .card-index {
        position: absolute;
        top: 0.9375rem;
        left: 1rem;
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        letter-spacing: 0.18em;
        color: rgb(255 255 255 / 62%);
    }

    .price {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        display: inline-flex;
        align-items: center;
        height: 1.75rem;
        padding-inline: 0.625rem;
        border: 1px solid rgb(255 255 255 / 26%);
        border-radius: 999px;
        background-color: rgb(10 10 10 / 52%);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.1em;
        line-height: 1;
        color: var(--ink);
    }

    .price--free {
        border-color: color-mix(in srgb, var(--accent) 55%, transparent);
        color: var(--accent);
    }

    .card-content {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        padding: 1.125rem 1.25rem 1.25rem;
    }

    .card-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .card-category {
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-muted);
    }

    .card-flag {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
    }

    .flag-dot {
        width: 0.25rem;
        height: 0.25rem;
        border-radius: 50%;
        background-color: var(--accent);
    }

    .card-title {
        margin-top: 0.5rem;
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: var(--ink);
    }

    .bento-item--1 .card-title {
        font-size: clamp(1.375rem, 2vw, 1.75rem);
    }

    .card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.125rem;
        padding-top: 0.875rem;
        border-top: 1px solid color-mix(in srgb, var(--border-strong) 45%, transparent);
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.04em;
        color: var(--ink-muted);
    }

    .empty {
        padding: 3rem 0;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-muted);
    }

    @media (min-width: 768px) {
        .section-head {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2.5rem;
        }

        .section-link {
            flex: none;
            margin-bottom: 0.125rem;
        }

        .section-lead {
            font-size: 1rem;
        }
    }

    @media (min-width: 1024px) {
        .bento-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            grid-template-rows: repeat(2, minmax(260px, auto));
        }

        .bento-item--1 {
            grid-column: span 6;
            grid-row: span 2;
        }

        .bento-item--1 .card {
            height: 100%;
        }

        .bento-item--2 {
            grid-column: span 6;
            grid-row: span 1;
        }

        .bento-item--3 {
            grid-column: span 3;
            grid-row: span 1;
        }

        .bento-item--4 {
            grid-column: span 3;
            grid-row: span 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .card:hover {
            transform: none;
        }
    }
</style>