---
import type { Product } from "../data/products";

interface Props {
	product: Product;
	class?: string;
}

const { product, class: className } = Astro.props;
---

<div
	class:list={["art", className]}
	style={`--art-glow: ${product.art.glow}; --art-mid: ${product.art.mid}; --art-base: ${product.art.base};`}
	aria-hidden="true"
>
	<span class="art-base"></span>
	<span class={`motif motif--${product.motif}`}></span>
	<span class="art-shade"></span>
</div>

<style>
	.art {
		position: absolute;
		inset: 0;
		overflow: hidden;
		isolation: isolate;
	}

	.art-base {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(115% 90% at 18% 6%, color-mix(in srgb, var(--art-glow) 92%, transparent), transparent 64%),
			radial-gradient(95% 75% at 88% 102%, var(--art-mid), transparent 74%),
			linear-gradient(155deg, var(--art-base), #050505 88%);
		transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
		will-change: transform;
	}

	.motif {
		position: absolute;
		inset: -20%;
		opacity: 0.55;
		pointer-events: none;
	}

	.motif--rings {
		background: repeating-radial-gradient(
			circle at 50% 118%,
			transparent 0 26px,
			rgb(255 255 255 / 10%) 26px 27px
		);
		-webkit-mask-image: radial-gradient(ellipse 80% 90% at 50% 100%, #000 15%, transparent 76%);
		mask-image: radial-gradient(ellipse 80% 90% at 50% 100%, #000 15%, transparent 76%);
	}

	.motif--lines {
		background: repeating-linear-gradient(
			104deg,
			transparent 0 19px,
			rgb(255 255 255 / 8%) 19px 20px
		);
		-webkit-mask-image: radial-gradient(ellipse 95% 85% at 40% 45%, #000 8%, transparent 80%);
		mask-image: radial-gradient(ellipse 95% 85% at 40% 45%, #000 8%, transparent 80%);
	}

	.motif--dots {
		background-image: radial-gradient(rgb(255 255 255 / 22%) 1px, transparent 1.4px);
		background-size: 14px 14px;
		-webkit-mask-image: radial-gradient(ellipse 90% 80% at 60% 40%, #000 6%, transparent 78%);
		mask-image: radial-gradient(ellipse 90% 80% at 60% 40%, #000 6%, transparent 78%);
	}

	.art-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(0 0 0 / 82%), rgb(0 0 0 / 18%) 52%, rgb(0 0 0 / 34%)),
			radial-gradient(120% 100% at 50% 50%, transparent 55%, rgb(0 0 0 / 42%));
	}

	@media (hover: hover) and (pointer: fine) {
		:global(a:hover) .art-base {
			transform: scale(1.045);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(a:hover) .art-base {
			transform: none;
		}
	}
</style>
