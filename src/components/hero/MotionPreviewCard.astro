---
import type { WaveTrack } from "../../lib/waveform";
import MultiTrackWave from "./MultiTrackWave.astro";

interface Props {
	tracks: WaveTrack[];
}

const { tracks } = Astro.props;
---

<div
	class="preview-frame"
	role="img"
	aria-label="Motion loop preview: a multitrack DAW view with four stacked audio stems and their waveforms; the beat stem is soloed in signal lime. Framed by technical readouts."
>
	<div class="preview-grid" aria-hidden="true"></div>

	<span class="corner corner--tl">MULTITRACKS</span>
	<span class="corner corner--tr">
		<span class="dot" aria-hidden="true"></span>
		LOOPS
	</span>

	<MultiTrackWave tracks={tracks} />

	<span class="corner corner--bl">WORSHIP</span>
	<span class="corner corner--br">
		<span class="dot" aria-hidden="true"></span>
		FOR CHORUS
	</span>
</div>

<style>
	.preview-frame {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 15rem;
		padding: 2.5rem 0.75rem 2.25rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--border-strong) 70%, transparent);
		background:
			radial-gradient(ellipse 60% 70% at 50% 50%, rgb(217 250 87 / 7%), transparent 70%),
			color-mix(in srgb, var(--canvas) 95%, transparent);
		-webkit-backdrop-filter: blur(4px);
		backdrop-filter: blur(4px);
	}

	.preview-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(to right, rgb(255 255 255 / 5%) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(255 255 255 / 5%) 1px, transparent 1px);
		background-size: 40px 40px;
		-webkit-mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, #000 20%, transparent 88%);
		mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, #000 20%, transparent 88%);
	}

	.corner {
		position: absolute;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.14em;
		line-height: 1;
		color: var(--ink-muted);
	}

	.corner--tl {
		top: 0.875rem;
		left: 1rem;
	}

	.corner--tr {
		top: 0.875rem;
		right: 1rem;
		text-align: right;
	}

	.corner--bl {
		bottom: 0.875rem;
		left: 1rem;
	}

	.corner--br {
		bottom: 0.875rem;
		right: 1rem;
	}

	.dot {
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 50%;
		background-color: var(--accent);
		flex: none;
	}

	@media (min-width: 640px) {
		.preview-frame {
			min-height: 17rem;
			padding: 2.75rem 1.25rem 2.5rem;
		}

		.corner {
			font-size: 0.625rem;
		}
	}

	@media (min-width: 768px) {
		.preview-frame {
			min-height: 17.5rem;
		}
	}

	@media (max-width: 359px) {
		.corner {
			font-size: 0.5rem;
			letter-spacing: 0.06em;
		}

		.corner--tl,
		.corner--bl {
			left: 0.625rem;
		}

		.corner--tr,
		.corner--br {
			right: 0.625rem;
		}
	}
</style>
