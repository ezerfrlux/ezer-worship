---
import type { WaveTrack } from "../../lib/waveform";

interface Props {
	track: WaveTrack;
}

const { track } = Astro.props;
---

<div
	class:list={["track", track.accent && "track--active"]}
	style={`--dur:${track.duration}s`}
>
	<span class="track-label">{track.id}: {track.name}</span>

	<div class="track-lane">
		<div class="track-bars">
			{track.bars.map((bar) => (
				<span
					class="bar"
					style={`--h:${bar.height}%;--low:${bar.low}%;--high:${bar.high}%;--delay:${bar.delay}ms`}
				></span>
			))}
		</div>
	</div>
</div>

<style>
	.track {
		display: grid;
		grid-template-columns: 6.25rem minmax(0, 1fr);
		align-items: center;
		gap: 0.625rem;
		padding: 0.1875rem 0.25rem;
		border-radius: 2px;
	}

	.track + .track {
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 9%, transparent);
	}

	.track--active {
		background-color: rgb(217 250 87 / 4%);
		box-shadow: inset 2px 0 0 var(--accent);
	}

	.track-label {
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.1em;
		line-height: 1.2;
		color: var(--ink-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.track--active .track-label {
		color: var(--ink);
	}

	.track--active .track-label::before {
		content: "";
		display: inline-block;
		width: 0.25rem;
		height: 0.25rem;
		margin-right: 0.375rem;
		border-radius: 50%;
		background-color: var(--accent);
		box-shadow: 0 0 0 3px rgb(217 250 87 / 14%);
		vertical-align: middle;
	}

	.track-lane {
		position: relative;
		display: flex;
		align-items: center;
		height: 1.75rem;
		padding-inline: 0.25rem;
		background-color: rgb(255 255 255 / 2.5%);
		border-radius: 2px;
	}

	.track-lane::before {
		content: "";
		position: absolute;
		top: 50%;
		right: 0.25rem;
		left: 0.25rem;
		height: 1px;
		background-color: var(--border-strong);
		opacity: 0.12;
	}

	.track--active .track-lane {
		background-color: rgb(217 250 87 / 4%);
	}

	.track-bars {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(1px, 0.14vw, 2px);
		width: 100%;
		height: 100%;
	}

	.bar {
		display: block;
		flex: 1 1 0;
		min-width: 1px;
		max-width: 3.5px;
		height: var(--h);
		border-radius: 999px;
		background-color: var(--ink-muted);
		opacity: 0.46;
		animation: equalize var(--dur, 3s) cubic-bezier(0.37, 0, 0.63, 1) infinite;
		animation-delay: var(--delay);
		will-change: height;
	}

	.track--active .bar {
		background-color: var(--accent);
		opacity: 0.92;
	}

	@keyframes equalize {
		0%,
		100% {
			height: var(--low);
		}
		50% {
			height: var(--high);
		}
	}

	@media (min-width: 640px) {
		.track {
			grid-template-columns: 6.5rem minmax(0, 1fr);
			gap: 0.875rem;
		}

		.track-lane {
			height: 2.25rem;
		}
	}

	@media (max-width: 479px) {
		.track-bars .bar:nth-child(even) {
			display: none;
		}
	}

	@media (max-width: 359px) {
		.track {
			grid-template-columns: 5.75rem minmax(0, 1fr);
			gap: 0.5rem;
		}

		.track-label {
			font-size: 0.5rem;
			letter-spacing: 0.05em;
		}

		.track-lane {
			height: 1.625rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bar {
			animation: none;
		}
	}
</style>
