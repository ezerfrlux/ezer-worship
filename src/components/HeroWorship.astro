---
import { createMotionTracks } from "../lib/waveform";
import HeroActions from "./hero/HeroActions.astro";
import HeroSpecs from "./hero/HeroSpecs.astro";
import MotionPreviewCard from "./hero/MotionPreviewCard.astro";

interface Props {
	title?: string;
	description?: string;
	primaryLabel?: string;
	primaryHref?: string;
	secondaryLabel?: string;
	secondaryHref?: string;
}

const {
	title = "Set the room before the first note.",
	description = "Worship loops, backgrounds, and visual patches for churches — built to sit quietly behind the moment.",
	primaryLabel = "Explore loops",
	primaryHref = "/loops",
	secondaryLabel = "Free resources",
	secondaryHref = "/free",
} = Astro.props;

const tracks = createMotionTracks();
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-wash" aria-hidden="true"></div>
	<div class="hero-grid" aria-hidden="true"></div>

	<div class="hero-inner">
		<h1 id="hero-title" class="hero-title">{title}</h1>

		<p class="hero-lead">{description}</p>

		<div class="preview">
			<MotionPreviewCard tracks={tracks} />
		</div>

		<HeroActions
			primaryLabel={primaryLabel}
			primaryHref={primaryHref}
			secondaryLabel={secondaryLabel}
			secondaryHref={secondaryHref}
		/>
	</div>

	<HeroSpecs />
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		min-height: calc(100svh - var(--header-h));
		overflow: hidden;
	}

	.hero-wash {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(60% 50% at 50% 0%, rgb(255 255 255 / 7%), transparent 70%);
	}

	.hero-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(to right, rgb(255 255 255 / 4%) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(255 255 255 / 4%) 1px, transparent 1px);
		background-size: 72px 72px;
		-webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 42%, #000 10%, transparent 78%);
		mask-image: radial-gradient(ellipse 75% 70% at 50% 42%, #000 10%, transparent 78%);
	}

	.hero-inner {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding: 2rem var(--gutter);
		text-align: center;
	}

	.hero-title {
		max-width: 20ch;
		margin-top: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6.4vw, 4.5rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: var(--ink);
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 36rem;
		margin-top: 0.875rem;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--ink-muted);
		text-wrap: pretty;
	}

	.preview {
		width: 100%;
		max-width: 52rem;
		margin-top: 1.75rem;
	}

	@media (min-width: 640px) {
		.hero-lead {
			font-size: 1rem;
		}
	}

	@media (max-width: 639px) {
		.hero-inner {
			padding: 1.5rem var(--gutter);
		}

		.preview {
			margin-top: 1.5rem;
		}
	}

	@media (min-width: 1024px) and (max-height: 900px) {
		.hero-title {
			font-size: clamp(2.5rem, 4.6vw, 3.75rem);
		}

		.preview {
			max-width: 46rem;
			margin-top: 1.5rem;
		}
	}
</style>
