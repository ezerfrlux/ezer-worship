---
const navigation = [
	{ label: "STORE", href: "/store" },
	{ label: "LOOPS", href: "/loops" },
	{ label: "MULTITRACKS", href: "/visuals" },
	{ label: "PRESETS", href: "/patches" },
];
---

<header class="site-header">
	<div class="header-bar">
		<a class="brand" href="/" aria-label="EZER-WORSHIP home">
			EZER<span class="brand-dot" aria-hidden="true">.</span>
		</a>

		<nav class="nav" aria-label="Main">
			{navigation.map((item) => (
				<a class="nav-link" href={item.href}>{item.label}</a>
			))}
		</nav>

		<button
			class="bag"
			type="button"
			data-cart-open
			aria-haspopup="dialog"
			aria-controls="cart-drawer"
			aria-expanded="false"
			aria-label="Open bag, 0 items"
		>
			CART <span class="bag-count" data-cart-count>[00]</span>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 50;
		background-color: color-mix(in srgb, var(--canvas) 92%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 32%, transparent);
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		backdrop-filter: blur(20px) saturate(140%);
	}

	.header-bar {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			"brand bag"
			"nav nav";
		align-items: center;
		gap: 0.25rem 1.5rem;
		width: 100%;
		max-width: var(--maxw);
		min-height: var(--header-h);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-block: 0.875rem;
	}

	.brand {
		grid-area: brand;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		min-height: 1.5rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--ink);
	}

	.brand-dot {
		color: var(--accent);
	}

	.nav {
		grid-area: nav;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.125rem;
		margin-top: 0.25rem;
		padding-top: 0.875rem;
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 15%, transparent);
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		min-height: 1.5rem;
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		color: var(--ink-muted);
		transition: color 150ms ease;
	}

	.nav-link:hover {
		color: var(--ink);
	}

	.bag {
		grid-area: bag;
		justify-self: end;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border-strong);
		background-color: transparent;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.16em;
		line-height: 1;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 150ms ease;
	}

	.bag:hover {
		background-color: var(--hover);
	}

	.bag-count {
		color: var(--ink-muted);
	}

	@media (min-width: 640px) {
		.nav {
			gap: 2.25rem;
		}
	}

	@media (min-width: 1024px) {
		.header-bar {
			grid-template-columns: 1fr auto 1fr;
			grid-template-areas: "brand nav bag";
			gap: 1.5rem;
			padding-block: 0;
		}

		.nav {
			margin-top: 0;
			padding-top: 0;
			border-top: 0;
		}
	}
</style>
