---
---

<dialog
	id="cart-drawer"
	class="drawer"
	data-cart-drawer
	aria-labelledby="cart-title"
>
	<div class="drawer-backdrop" data-cart-backdrop aria-hidden="true"></div>

	<div class="drawer-shell">
		<header class="drawer-head">
			<div class="drawer-heading">
				<p class="drawer-kicker">Your selection</p>
				<h2 id="cart-title" class="drawer-title">
					Bag
					<span class="drawer-count" data-drawer-count>[00]</span>
				</h2>
			</div>

			<button class="close" type="button" data-cart-close aria-label="Close bag">
				<span class="close-icon" aria-hidden="true">✕</span>
				<span class="close-key" aria-hidden="true">[ESC]</span>
			</button>
		</header>

		<div class="drawer-body">
			<ul class="cart-list" data-cart-list aria-label="Items in your bag"></ul>

			<div class="cart-empty" data-cart-empty hidden>
				<p class="empty-title">Your bag is empty.</p>
				<p class="empty-copy">
					Loops, multitracks, and presets will appear here once you add them.
				</p>
				<a class="empty-link" href="/store">
					Browse the store
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<footer class="drawer-foot" data-cart-foot hidden>
			<div class="total-row">
				<span class="total-label">Total</span>
				<span class="total-value" data-cart-total>$0</span>
			</div>
			<p class="foot-note">Instant download after checkout. Taxes calculated at checkout.</p>
			<a class="checkout" href="/checkout">
				Proceed to checkout
				<span class="checkout-arrow" aria-hidden="true">→</span>
			</a>
		</footer>

		<p class="visually-hidden" role="status" aria-live="polite" data-cart-announcer></p>
	</div>
</dialog>

<template data-cart-item-template>
	<li class="cart-item">
		<span class="item-thumb" aria-hidden="true"></span>

		<div class="item-info">
			<p class="item-category"></p>
			<a class="item-title" data-item-link></a>
			<p class="item-resources"></p>
		</div>

		<div class="item-side">
			<span class="item-price"></span>
			<button class="item-remove" type="button" data-remove-id>Remove</button>
		</div>
	</li>
</template>

<script>
	import {
		formatCartCount,
		readCart,
		removeFromCart,
		type CartItem,
	} from "../lib/cart";

	const drawer = document.querySelector<HTMLDialogElement>("[data-cart-drawer]");

	if (drawer) {
		const list = drawer.querySelector<HTMLElement>("[data-cart-list]");
		const template = document.querySelector<HTMLTemplateElement>("[data-cart-item-template]");
		const count = drawer.querySelector<HTMLElement>("[data-drawer-count]");
		const total = drawer.querySelector<HTMLElement>("[data-cart-total]");
		const empty = drawer.querySelector<HTMLElement>("[data-cart-empty]");
		const foot = drawer.querySelector<HTMLElement>("[data-cart-foot]");
		const closeButton = drawer.querySelector<HTMLButtonElement>("[data-cart-close]");
		const backdrop = drawer.querySelector<HTMLElement>("[data-cart-backdrop]");
		const announcer = drawer.querySelector<HTMLElement>("[data-cart-announcer]");
		const bodyOverflow = document.body.style.overflow;

		let lastFocus: HTMLElement | null = null;
		let closeTimer: number | undefined;

		const totalFor = (items: CartItem[]): string => {
			const amount = items.reduce((sum, item) => {
				const value = Number(item.price.replace(/[^0-9.]/g, ""));
				return sum + (Number.isFinite(value) ? value : 0);
			}, 0);

			return `$${amount}`;
		};

		const render = () => {
			const items = readCart();

			if (count) count.textContent = formatCartCount(items.length);
			if (total) total.textContent = totalFor(items);
			if (empty) empty.hidden = items.length > 0;
			if (foot) foot.hidden = items.length === 0;
			if (!list || !template) return;

			list.replaceChildren();

			for (const item of items) {
				const fragment = template.content.cloneNode(true) as DocumentFragment;
				const thumb = fragment.querySelector<HTMLElement>(".item-thumb");
				const category = fragment.querySelector<HTMLElement>(".item-category");
				const title = fragment.querySelector<HTMLAnchorElement>("[data-item-link]");
				const resources = fragment.querySelector<HTMLElement>(".item-resources");
				const price = fragment.querySelector<HTMLElement>(".item-price");
				const remove = fragment.querySelector<HTMLButtonElement>("[data-remove-id]");

				if (thumb && item.art) {
					thumb.style.setProperty("--thumb-glow", item.art.glow);
					thumb.style.setProperty("--thumb-mid", item.art.mid);
					thumb.style.setProperty("--thumb-base", item.art.base);
				}

				if (category) category.textContent = item.category ?? "Digital pack";
				if (title) {
					title.textContent = item.title;
					title.href = `/store/${item.id}`;
				}
				if (resources) {
					resources.textContent = item.resources ?? "";
					resources.hidden = !item.resources;
				}
				if (price) price.textContent = item.price;
				if (remove) {
					remove.dataset.removeId = item.id;
					remove.setAttribute("aria-label", `Remove ${item.title} from bag`);
				}

				list.append(fragment);
			}
		};

		const setExpanded = (expanded: boolean) => {
			document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((trigger) => {
				trigger.setAttribute("aria-expanded", String(expanded));
			});
		};

		const openDrawer = () => {
			if (drawer.open) {
				window.clearTimeout(closeTimer);
				drawer.classList.remove("is-closing");
				drawer.classList.add("is-open");
				return;
			}

			lastFocus =
				document.activeElement instanceof HTMLElement && document.activeElement !== document.body
					? document.activeElement
					: document.querySelector<HTMLElement>("[data-cart-open]");
			render();
			document.body.style.overflow = "hidden";
			drawer.showModal();
			setExpanded(true);

			// Let the dialog paint in its closed position first: starting the
			// animation in the same frame as showModal() makes some browsers
			// paint the panel straight into place instead of sliding it.
			requestAnimationFrame(() => {
				requestAnimationFrame(() => drawer.classList.add("is-open"));
			});
			closeButton?.focus({ preventScroll: true });
		};

		const closeDrawer = () => {
			if (!drawer.open || drawer.classList.contains("is-closing")) return;

			drawer.classList.add("is-closing");
			drawer.classList.remove("is-open");

			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(() => drawer.close(), reduceMotion ? 0 : 340);
		};

		document.querySelectorAll<HTMLButtonElement>("[data-cart-open]").forEach((button) => {
			button.addEventListener("click", (event) => {
				event.preventDefault();
				openDrawer();
			});
		});

		closeButton?.addEventListener("click", closeDrawer);
		backdrop?.addEventListener("click", closeDrawer);

		drawer.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeDrawer();
		});

		drawer.addEventListener("close", () => {
			drawer.classList.remove("is-open", "is-closing");
			document.body.style.overflow = bodyOverflow;
			setExpanded(false);
			lastFocus?.focus();
		});

		list?.addEventListener("click", (event) => {
			const target = (event.target as Element).closest<HTMLButtonElement>("[data-remove-id]");
			if (!target) return;

			const removedTitle =
				target.closest(".cart-item")?.querySelector<HTMLElement>(".item-title")?.textContent ??
				"Item";

			removeFromCart(target.dataset.removeId ?? "");
			if (announcer) announcer.textContent = `${removedTitle} removed from bag.`;

			requestAnimationFrame(() => {
				const next = list.querySelector<HTMLButtonElement>("[data-remove-id]");
				(next ?? closeButton)?.focus();
			});
		});

		window.addEventListener("ezer:cart-change", () => {
			if (drawer.open) render();
		});

		window.addEventListener("ezer:cart-open", openDrawer);
		window.addEventListener("ezer:cart-close", closeDrawer);
	}
</script>

<style>
	.drawer {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: 100%;
		height: 100vh;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		overflow: hidden;
		border: 0;
		background-color: transparent;
		color: var(--ink);
	}

	.drawer[open] {
		display: block;
	}

	.drawer-backdrop {
		position: absolute;
		inset: 0;
		background-color: transparent;
	}

	.drawer::backdrop {
		background-color: rgb(0 0 0 / 58%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		opacity: 0;
	}

	.drawer.is-open::backdrop {
		animation: drawer-backdrop-in 300ms ease both;
	}

	.drawer.is-closing::backdrop {
		animation: drawer-backdrop-out 300ms ease both;
	}

	@keyframes drawer-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes drawer-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	.drawer-shell {
		position: fixed;
		inset-block: 0;
		inset-inline-end: 0;
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 100%;
		min-height: 0;
		overflow: hidden;
		background-color: var(--canvas);
		transform: translateX(100%);
	}

	.drawer.is-open .drawer-shell {
		animation: drawer-in 320ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}

	.drawer.is-closing .drawer-shell {
		animation: drawer-out 320ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}

	@keyframes drawer-in {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}

	@keyframes drawer-out {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(100%);
		}
	}

	.drawer-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: max(1.25rem, env(safe-area-inset-top)) 1.25rem 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 55%, transparent);
	}

	.drawer-heading {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.drawer-kicker {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.drawer-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.035em;
		color: var(--ink);
	}

	.drawer-count {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
	}

	.close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding-inline: 0.625rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.25rem;
		background-color: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.close:hover {
		background-color: var(--hover);
		border-color: color-mix(in srgb, var(--border-strong) 65%, var(--ink) 35%);
	}

	.close-icon {
		font-size: 0.8125rem;
		line-height: 1;
	}

	.close-key {
		font-family: var(--font-mono);
		font-size: 0.5rem;
		letter-spacing: 0.12em;
		color: var(--ink-muted);
	}

	.drawer-body {
		flex: 1 1 auto;
		min-height: 0;
		padding: 1rem 1.25rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--border-strong) transparent;
	}

	.drawer-body::-webkit-scrollbar {
		width: 6px;
	}

	.drawer-body::-webkit-scrollbar-track {
		background: transparent;
	}

	.drawer-body::-webkit-scrollbar-thumb {
		background-color: var(--border-strong);
		border-radius: 999px;
	}

	.cart-list {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cart-item {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) auto;
		gap: 0.875rem;
		align-items: start;
		padding: 0.875rem;
		background-color: color-mix(in srgb, var(--canvas-raised) 82%, transparent);
		border: 1px solid color-mix(in srgb, var(--border-strong) 58%, transparent);
		border-radius: 0.25rem;
	}

	.item-thumb {
		width: 3.5rem;
		height: 3.5rem;
		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 0.125rem;
		background:
			radial-gradient(120% 100% at 18% 4%, var(--thumb-glow, #242424), transparent 66%),
			linear-gradient(150deg, var(--thumb-mid, #171717), var(--thumb-base, #0c0c0c));
	}

	.item-info {
		min-width: 0;
	}

	.item-category {
		font-family: var(--font-mono);
		font-size: 0.5rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.item-title {
		display: inline-block;
		margin-top: 0.25rem;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.item-title:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.item-resources {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}

	.item-side {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.item-price {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.2;
		color: var(--ink);
	}

	.item-remove {
		min-height: 1.75rem;
		padding: 0;
		border: 0;
		background: none;
		font-family: var(--font-mono);
		font-size: 0.5rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
		cursor: pointer;
		transition: color 160ms ease;
	}

	.item-remove:hover {
		color: var(--ink);
	}

	.cart-empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.625rem;
		padding: 3.5rem 0;
	}

	.cart-empty[hidden],
	.drawer-foot[hidden] {
		display: none;
	}

	.empty-title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--ink);
	}

	.empty-copy {
		max-width: 26ch;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.empty-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.empty-link span {
		transition: transform 160ms ease;
	}

	.empty-link:hover span {
		transform: translateX(3px);
	}

	.drawer-foot {
		flex: none;
		padding: 1.125rem 1.25rem max(1.25rem, env(safe-area-inset-bottom));
		border-top: 1px solid color-mix(in srgb, var(--border-strong) 55%, transparent);
		background-color: var(--canvas);
	}

	.total-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.total-label {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.total-value {
		font-family: var(--font-mono);
		font-size: 1.5rem;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.foot-note {
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.5rem;
		line-height: 1.6;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.checkout {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		min-height: 3.5rem;
		margin-top: 1rem;
		padding-inline: 1.125rem;
		border: 1px solid var(--accent);
		border-radius: 0.25rem;
		background-color: var(--accent);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--accent-ink);
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			transform 120ms ease;
	}

	.checkout:hover {
		background-color: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.checkout:active {
		transform: scale(0.99);
	}

	.checkout-arrow {
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		line-height: 1;
		transition: transform 160ms ease;
	}

	.checkout:hover .checkout-arrow {
		transform: translateX(3px);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 640px) {
		.drawer-shell {
			width: 440px;
			max-width: 440px;
			border-left: 1px solid color-mix(in srgb, var(--border-strong) 72%, transparent);
		}

		.drawer-head {
			padding: 1.5rem 1.5rem 1.125rem;
		}

		.drawer-body {
			padding: 1.125rem 1.5rem;
		}

		.drawer-foot {
			padding: 1.25rem 1.5rem max(1.5rem, env(safe-area-inset-bottom));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.drawer.is-open .drawer-shell,
		.drawer.is-closing .drawer-shell {
			animation: none;
			transform: translateX(0);
		}

		.drawer.is-open::backdrop,
		.drawer.is-closing::backdrop {
			animation: none;
			opacity: 1;
		}

		.checkout:active {
			transform: none;
		}
	}
</style>
