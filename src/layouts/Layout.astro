---
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#102d35" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="EZER-WORSHIP — high-quality worship loops, backgrounds, and visual patches for churches."
		/>
		<title>EZER-WORSHIP — Worship media pack</title>
		<Font cssVariable="--font-plus-jakarta-sans" />
		<Font cssVariable="--font-space-grotesk" />
	</head>
	<body>
		<SiteHeader />
		<slot />
	</body>
</html>
